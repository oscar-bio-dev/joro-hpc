# ──────────────────────────────────────────────────────────────────────────────
# JORO-HPC  ·  .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Directorios de compilación y datos locales ───────────────────────────────
build/
data
data/

# ── Binarios y objetos ───────────────────────────────────────────────────────
*.o
*.obj
*.a
*.so
*.dylib
*.exe
*.out
joro_hpc
joro_evaluate

# ── Datos científicos grandes (NetCDF, HDF5) ────────────────────────────────
*.nc
*.nc4
*.h5
*.hdf5
*.hdf
*.grib
*.grib2

# ── Rasters y GIS ────────────────────────────────────────────────────────────
*.tif
*.tiff
*.geotiff
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
*.gpkg-shm
*.gpkg-wal
*.xlsx
*.xls

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
*.egg

# ── Editores e IDEs ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
pyrightconfig.json

# ── CMake cache ──────────────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# ── LaTeX (artefactos intermedios; el PDF final sí se versiona) ─────────────
*.aux
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg

# ── Intel oneAPI temporales ──────────────────────────────────────────────────
*.ipo
*.optrpt

# ── Archivos comprimidos de respaldo ─────────────────────────────────────────
*.zip
*.tar.gz
*.tar.bz2

# ── Secretos / entorno local (usar .env.example como plantilla) ─────────────
.env
.env.*
!.env.example
.cdsapirc
*.pem
*.key

# ── Pipeline local de ingesta, telemetría y auditorías privadas ─────────────
local_pipeline/
docs/internal_audits/
docs/reports/0[5-9]_*.md
tmp/
docs/tmp/
*.log
download_watchdog.log
download_progress.json
*_backup.*
*.bak
*.orig
