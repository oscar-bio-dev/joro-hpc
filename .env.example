# JORO-HPC · plantilla de variables de entorno (copiar a `.env`, que está en .gitignore).
# Uso:  cp .env.example .env && $EDITOR .env && set -a && source .env && set +a
# Los scripts de Python (scripts/python/joro_db.py) y scripts/run_calibration.sh cargan `.env`
# automáticamente; los ejecutables C++ leen estas variables del entorno del proceso.

JORO_DB_HOST=localhost
JORO_DB_PORT=5433
JORO_DB_NAME=joro_db
JORO_DB_USER=joro_admin
# Obligatoria para conectar a PostGIS; no existe valor por defecto.
JORO_DB_PASSWORD=
